{
    "name": "koh/sylius-webmcp",
    "description": "WebMCP for the Sylius storefront — MCP tools embedded in storefront web pages.",
    "type": "sylius-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/sylius-webmcp/issues",
        "source": "https://github.com/ohartwig/sylius-webmcp",
        "security": "https://github.com/ohartwig/sylius-webmcp/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^12.5 || ^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusWebmcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusWebmcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
