{
    "name": "koh/sylius-webmcp",
    "description": "WebMCP for the Sylius storefront \u2014 MCP tools embedded in storefront web pages.",
    "type": "sylius-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/sylius-webmcp/-/issues",
        "source": "https://github.com/ole-hartwig/sylius-webmcp"
    },
    "require": {
        "php": ">=8.2",
        "sylius/sylius": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusWebmcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusWebmcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
