    Publishes the agent API base as a meta tag and loads the WebMCP
    registration script. The script reads the meta tag rather than guessing a
    path, so moving the API is a configuration change.
#}
<meta name="koh-agent-api" content="{{ koh_webmcp_api_base }}">
<script src="{{ asset('bundles/kohsyliuswebmcp/webmcp.js') }}" defer></script>
